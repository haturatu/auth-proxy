# --- Server Settings ---
# The port for the proxy server to listen on
LISTEN_PORT=8080

# --- Required ---
# The URL of the backend service you want to protect
TARGET_URL=http://host.docker.internal:8081

# A long, random string for securing session cookies and JWTs
# For production, generate a new key using: openssl rand -base64 45
SESSION_SECRET=

# (Required) A 32-byte random key for XSRF protection.
# Generate with: openssl rand -base64 32
XSRF_SECRET_KEY=

# --- Docker Compose (optional) ---
# SQLite by default; switch to compose.yaml:compose.postgres.yaml
# or compose.yaml:compose.mysql.yaml
COMPOSE_FILE=compose.yaml
AUTH_PORT=8080
BIND_ADDRESS=127.0.0.1
# true for HTTPS (including TLS termination at nginx), false only for localhost HTTP
COOKIE_SECURE=true
DB_USER=auth
DB_NAME=auth
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Database ---
# Use ONE of the following options:

# Option 1: PostgreSQL or MySQL (Recommended)
# Example: postgres://user:password@host:port/dbname?sslmode=disable
# Example: mysql://user:password@host:3306/dbname?charset=utf8mb4&parseTime=true
# DATABASE_URL=

# Option 2: SQLite (Default if DATABASE_URL is not set)
DATABASE_PATH=./auth.db

# --- Frontend & Proxy ---
# Frontend mode: "js" (default) or "php"
FRONTEND_TYPE=js
# If true, protects the frontend path with session authentication
PROTECT_FRONTEND=false
# If true, protects the API path with bearer token authentication
PROTECT_API=false
# Base path for frontend routes to be protected
FRONT_PATH=/
# Base path for API routes to be protected
API_PATH=/api/

# --- Security Policies ---

# Brute-force protection settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=10

# User creation rate limit settings
USER_CREATION_RATE_LIMIT_MAX_REQUESTS=5
USER_CREATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Password policy (none, standard, enhanced, strict)
PASSWORD_POLICY=standard

# --- Token Durations ---
# Duration for the web session cookie
TOKEN_DURATION_HOURS=24
# Duration for the API JWT access token
ACCESS_TOKEN_DURATION_MINUTES=15
# Duration for the API JWT refresh token
REFRESH_TOKEN_DURATION_DAYS=7

# --- Optional: Path Overrides ---
# Uncomment and change these to avoid URL conflicts with your backend application.
# AUTH_PATH_LOGIN=/login
# AUTH_PATH_REGISTER=/register
# AUTH_PATH_LOGOUT=/logout
# AUTH_PATH_ACCOUNT=/account
# AUTH_PATH_ACCOUNT_PASSWORD=/account/password
# AUTH_PATH_ADMIN=/admin
# AUTH_PATH_ADMIN_USERS_API=/api/admin/users
# AUTH_ASSETS_PATH=/assets

# --- PHP Frontend Settings (only needed if FRONTEND_TYPE=php) ---
# PHP_FPM_SOCKET=/run/php-fpm/php-fpm.sock
# PHP_DOC_ROOT=

# --- Security hardening ---
# Browser API authentication (only effective when PROTECT_API=true)
# bearer: JWT Authorization header only (default, recommended for CLI).
# session: HttpOnly auth_token cookie only (SPA, EventSource, WebSocket).
# either: Bearer takes precedence; if absent, allow same-origin session cookie.
# To protect /api/events and other browser APIs, enable:
# PROTECT_API=true
API_AUTH_MODE=bearer
# origin (default): unsafe cookie requests need browser-verified same-origin
# signals only, so existing SPAs work without JavaScript changes.
# xsrf: also require /api/auth/csrf's X-XSRF-Token on unsafe requests.
API_SESSION_CSRF=origin

# Optional signed upstream identity, independent from SESSION_SECRET:
# Generate a dedicated signing seed with: openssl rand -base64 32
# UPSTREAM_ASSERTION_ED25519_SEED=
# JWT aud defaults to the TARGET_URL host:port. Backends must verify EdDSA,
# iss=auth-proxy, aud, iat, exp; never trust unsigned identity headers alone.
# UPSTREAM_ASSERTION_AUDIENCE=backend.internal:8081
# If the backend expects Authorization: Bearer, inject the signed assertion:
UPSTREAM_ASSERTION_AS_BEARER=false


# For direct HTTP access from another VLAN using http://192.168.x.x:8080,
# set COOKIE_SECURE=false above. HTTPS is strongly preferred.
# Only addresses/CIDRs of controlled reverse proxies, never all private LANs.
# Direct 192.168.x.x clients need no entry here.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,192.168.10.5/32
# Only when frontend and auth API use DIFFERENT origins. Same-origin LAN works without it.
# CSRF_TRUSTED_ORIGINS=http://192.168.20.10:8080
# Default: bcrypt. Optional: pbkdf2-sha256 (600,000 iterations). Old bcrypt hashes remain valid.
PASSWORD_HASH_ALGORITHM=bcrypt


# JWT audience for deployments sharing TARGET_URL (use a deployment-specific value)
# JWT_AUDIENCE=auth-proxy:production
